  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b -w",
    "clean": "rimraf \"packages/*/lib\" \"packages/*/*.tsbuildinfo\" coverage",
    "coverage": "jest --coverage",
    "cs": "changeset",
    "lint": "biome check",
    "nuke": "pnpm clean && rimraf node_modules \"packages/*/node_modules\"",
    "release": "changeset publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "pnpm lint && pnpm build && pnpm coverage",
    "version": "changeset version",
    "watch": "pnpm test:watch"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
